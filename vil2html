          #key_arg = '&nbsp;' if key_arg == ''
        end
        
        key_def = $key_defs[key_code] || { lbl: $2 ? $1 : row[col].to_s.sub('KC_', '').sub('KP_', '') }
        
        key_code = key_def[:lbl]
        key_code_chars = key_code.sub(/_T/, '').size
        key_code_chars = 3 if key_code == 'TD' && key_arg == '?1'
        key_code = %|<span class="HRM">#{$1}</span>| if key_code =~ /(.+)_T/
        lbl = key_code.dup
        lbl = '∇' if row[col] == 'KC_TRNS'
        lbl = '&nbsp;' if noop
        lbl = '&nbsp;' if hold
        
        if key_code == 'OSM'
          key_code = %|<span class="HRM">①</span>|
          key_code_chars = 1
          key_arg.sub! /.MOD_/, ''
          lbl = key_arg = ($key_defs[key_arg]&.[](:lbl) || key_arg)
        end
        
        if s = key_special[ row[col] ]
          has_arg, lbl = false, s[:lbl]
        end
        
        if row[col].to_s =~ /^LT(\d)/
          key_code = %|<span class="LT">#{layer_names[$1.to_i][:code]}</span>|
        end
        
        if row[col].to_s =~ /^TO\((\d)\)/
          has_arg = false
          lbl = %|<span class="TO">#{layer_names[$1.to_i][:code]}</span>|
        end
        
        if row[col].to_s =~ /^TG\((\d)\)/
          has_arg = false
          lbl = %|<span class="TG">#{layer_names[$1.to_i][:code]}</span>|
        end
        
        if has_arg
          is_short = "#{key_code}#{key_arg}".size == 2
          
          if key_arg.include?("\n")
            if key_code == '⇧'
              lbl = key_arg.split("\n")[0]
              lbl = %Q|<div class="key_name rows-1 #{get_class lbl}">#{lbl}</div>|
            elsif %w[ ⌥ ⌥ᴿ ].include?(key_code)
              key_arg = key_arg.split("\n")[1]
              is_short = "#{key_code}#{key_arg}".size == 2
              lbl = %Q|<div class="key_name rows-1 #{'combo' if is_short} len-#{key_code_chars}"><span class="mod">#{key_code}</span><span class="mod_key">#{CGI::escapeHTML key_arg}</span></div>|
            else
              lbl = %Q|<div class="key_name rows-#{key_arg.count("\n") + 1} #{'combo' if is_short} len-#{key_code_chars}"><span class="mod">#{key_code}</span><span class="mod_key">#{CGI::escapeHTML key_arg}</span></div>|
            end
          else
            lbl = %Q|<div class="key_name rows-1 #{'combo' if is_short} len-#{key_code_chars}"><span class="mod">#{key_code}</span><span class="mod_key">#{CGI::escapeHTML key_arg}</span></div>|
          end
        else
          lbl = lbl.split("\n")[1] if layer_names[layer_idx][:code] == :PROG && lbl.include?("\n")
          lbl = %Q|<div class="key_name rows-#{lbl.count("\n") + 1} #{get_class lbl} len-#{key_code_chars}">#{lbl}</div>|
        end

        # aggiungi tasto fantasma come spaziatore
        if row[0] == -1
          f.puts <<~HTML
            <div class="key hidden shift" style="max-height: #{'%.2f' % (3.0 * (column_shifts.max - shift))}rem">
              <div>column shift</div>
            </div>
          HTML
        end
        
        f.puts <<~HTML
          <div class="key #{'hidden' if missing}">
            <div class="surface #{'noop' if noop} #{'hold' if hold}">#{lbl}</div>
          </div>
        HTML
      end
      
      f.puts '</td>'
    end

    f.puts '</tr></table>'
  end

  f.puts <<~HTML
    <body>
    </html>
  HTML
end
