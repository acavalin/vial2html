  def get_class(lbl)
    small_syms1 = %w[ ↲ ⌘ ⌥ ⌫ ⌦ ⎙︎ 🖩 ↯ ⭡ ⭠︎ ⭣ ⭢︎ - ` ☀ ☼ ⛨ ]
    small_syms2 = %w[ ↵ ⎋ ⇧ ⇥ ⇱ ⇲ ↟ ↡ ↨ ✉ ⏹︎ ⏯︎ ⏸︎ ♫ ⏏ ⎵ ⚙ ]
    small_syms3 = %w[ ⎵ _ ]
    small_syms4 = %w[ 🖱↟ 🖱↡ 🖱↞ 🖱↠ 🖱+ 🖱- 🖱L 🖱D 🖱⋅ 🖱∶ 🖱∴ ]
    combo = %w[ ☰ ]

    klass = 'bigger1' if small_syms1.include?(lbl)
    klass = 'bigger2' if small_syms2.include?(lbl)
    klass = 'bigger3' if small_syms3.include?(lbl)
    klass = 'bigger4' if small_syms4.include?(lbl)
    klass = 'combo'   if combo.include?(lbl)
    klass
  end # get_class

